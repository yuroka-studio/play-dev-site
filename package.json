{
  "name": "play-dev-site",
  "version": "0.1.0",
  "description": "Static, multilingual developer site for Google Play: home, privacy policies and account-deletion pages generated from one config file.",
  "private": true,
  "type": "module",
  "license": "MIT",
  "author": "Yuroka Studio",
  "engines": {
    "node": "^22.18.0 || >=24"
  },
  "scripts": {
    "dev": "node scripts/next.mjs dev",
    "build": "node scripts/next.mjs build && node scripts/postbuild.mjs",
    "start": "node scripts/serve.mjs",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "check": "npm run lint && npm run typecheck",
    "test:e2e": "playwright test",
    "test": "npm run build && playwright test",
    "test:example": "node scripts/test-example.mjs"
  },
  "dependencies": {
    "next": "16.4.3",
    "next-intl": "^4.14.9",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@playwright/test": "^1.64.1",
    "@types/node": "^24",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.3",
    "smol-toml": "^1.9.1",
    "typescript": "^5"
  }
}
